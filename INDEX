<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tool tạo PowerShell chia folder theo tháng - FIXED</title>
<style>
:root{
  --bg:#0f1115; --panel:#171a21; --panel2:#1e222b; --text:#f5f7fb; --muted:#a9b0bd;
  --line:#2d3340; --accent:#4f8cff; --ok:#2fbf71; --danger:#ff5d6c; --warn:#ffb020;
}
*{box-sizing:border-box}
body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
.wrap{max-width:1180px;margin:0 auto;padding:28px}
h1{font-size:28px;margin:0 0 8px}
.sub{color:var(--muted);margin-bottom:24px;line-height:1.5}
.grid{display:grid;grid-template-columns:1fr 1.35fr;gap:18px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 8px 24px rgba(0,0,0,.18)}
label{display:block;font-weight:700;margin:0 0 8px}
input[type=text]{width:100%;padding:12px 13px;border-radius:10px;border:1px solid var(--line);background:var(--panel2);color:var(--text);font-size:15px;outline:none}
input[type=text]:focus{border-color:var(--accent)}
.mode{display:flex;gap:10px;margin-top:16px}
.mode label{flex:1;margin:0;border:1px solid var(--line);border-radius:10px;padding:12px;cursor:pointer;background:var(--panel2);font-weight:600}
.mode input{margin-right:8px}
.hint{font-size:13px;color:var(--muted);margin-top:8px;line-height:1.45}
.warn{margin-top:14px;padding:12px;border-radius:10px;background:rgba(255,176,32,.10);border:1px solid rgba(255,176,32,.35);color:#ffd58a}
.buttons{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
button{border:0;border-radius:10px;padding:11px 14px;font-weight:700;cursor:pointer;background:var(--accent);color:white;font-size:14px}
button.secondary{background:#2a3040}
button.good{background:var(--ok)}
button:hover{filter:brightness(1.08)}
textarea{width:100%;min-height:620px;resize:vertical;border-radius:12px;border:1px solid var(--line);background:#0b0d11;color:#d8e0eb;padding:14px;font-family:Consolas,monospace;font-size:13px;line-height:1.5}
.status{margin-top:10px;color:#9fd2ff;min-height:20px;font-weight:600}
.example{margin-top:18px;padding:14px;border-radius:12px;background:var(--panel2);border:1px solid var(--line);font-family:Consolas,monospace;font-size:13px;color:#dce3ee;line-height:1.55}
.pill{display:inline-block;font-size:12px;padding:4px 8px;border-radius:999px;background:#283044;color:#cfe0ff;margin-left:6px}
@media(max-width:900px){.grid{grid-template-columns:1fr}.wrap{padding:16px}}
</style>
</head>
<body>
<div class="wrap">
  <h1>Tool tạo PowerShell chia folder theo tháng</h1>
  <div class="sub">
    Nhập đường dẫn folder, chọn chế độ, rồi bấm <b>Tạo code PowerShell</b>.
    Bản này đã sửa lỗi nút bấm không sinh code.
  </div>

  <div class="grid">
    <div class="card">
      <label>1. Đường dẫn folder</label>
      <input id="root" type="text" value="E:\23. ÁO HOODIE" spellcheck="false">
      <div class="hint">Ví dụ: E:\1. BÓNG ĐÁ hoặc E:\23. ÁO HOODIE</div>

      <div class="mode">
        <label><input type="radio" name="mode" value="preview" checked> Xem thử <span class="pill">an toàn</span></label>
        <label><input type="radio" name="mode" value="real"> Chạy thật</label>
      </div>

      <div class="warn">
        Nên chạy <b>Xem thử</b> trước. Khi Excel báo cáo phân tháng đúng mới chọn <b>Chạy thật</b>.
      </div>

      <div class="buttons">
        <button id="generateBtn">Tạo code PowerShell</button>
        <button class="good" id="copyBtn">Copy code</button>
        <button class="secondary" id="downloadBtn">Tải file .ps1</button>
      </div>

      <div id="status" class="status"></div>

      <div class="example">
        Kết quả:<br><br>
        23. ÁO HOODIE<br>
        ├── 2025<br>
        │&nbsp;&nbsp;&nbsp;└── 12. THÁNG 12<br>
        └── 2026<br>
        &nbsp;&nbsp;&nbsp;&nbsp;├── 07. THÁNG 07<br>
        &nbsp;&nbsp;&nbsp;&nbsp;└── 08. THÁNG 08<br><br>
        File Excel báo cáo sẽ được tạo ngay trong folder đang xử lý.
      </div>
    </div>

    <div class="card">
      <label>2. Code PowerShell</label>
      <textarea id="code" spellcheck="false" placeholder="Code sẽ xuất hiện ở đây..."></textarea>
    </div>
  </div>
</div>

<script type="text/plain" id="ps-template">
# ============================================================
# TOOL CHIA FOLDER SẢN PHẨM THEO NĂM / THÁNG
# Báo cáo Excel: CHI_TIET, TONG_HOP, CAU_TRUC
# ============================================================

$Root = '__ROOT__'

# $true  = XEM THỬ, KHÔNG DI CHUYỂN
# $false = DI CHUYỂN THẬT
$Preview = __PREVIEW__

if (-not (Test-Path -LiteralPath $Root)) {
    Write-Host ""
    Write-Host "KHÔNG TÌM THẤY FOLDER:" -ForegroundColor Red
    Write-Host $Root -ForegroundColor Yellow
    return
}

$TimeStamp = Get-Date -Format "yyyyMMdd_HHmmss"
$ExcelReport = Join-Path $Root "BAO_CAO_CHIA_THANG_$TimeStamp.xlsx"
$Results = @()

# Chỉ lấy các folder sản phẩm trực tiếp trong Root.
# Bỏ qua folder năm như 2024, 2025, 2026...
$Products = Get-ChildItem -LiteralPath $Root -Directory |
    Where-Object { $_.Name -notmatch '^\d{4}$' }

foreach ($Product in $Products) {

    $LatestFile = Get-ChildItem `
        -LiteralPath $Product.FullName `
        -File `
        -Recurse `
        -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($LatestFile) {
        $Date = $LatestFile.LastWriteTime
        $DateSource = $LatestFile.FullName
    }
    else {
        $Date = $Product.LastWriteTime
        $DateSource = "Ngày chỉnh sửa folder"
    }

    $Year = $Date.Year
    $Month = "{0:D2}" -f $Date.Month
    $MonthFolder = "$Month. THÁNG $Month"

    $Destination = Join-Path $Root "$Year\$MonthFolder"
    $Target = Join-Path $Destination $Product.Name

    if ($Preview) {
        $Status = "XEM THỬ - CHƯA DI CHUYỂN"
    }
    else {
        if (-not (Test-Path -LiteralPath $Destination)) {
            New-Item -ItemType Directory -Path $Destination -Force | Out-Null
        }

        if (Test-Path -LiteralPath $Target) {
            $Status = "BỎ QUA - TRÙNG TÊN"
        }
        else {
            Move-Item -LiteralPath $Product.FullName -Destination $Destination
            $Status = "ĐÃ CHUYỂN"
        }
    }

    $Results += [PSCustomObject]@{
        SanPham     = $Product.Name
        Ngay        = $Date
        Nam         = $Year
        Thang       = $Month
        FolderThang = $MonthFolder
        NguonNgay   = $DateSource
        DuongDanCu  = $Product.FullName
        DuongDanMoi = $Target
        TrangThai   = $Status
    }

    Write-Host ""
    Write-Host "---------------------------------------------" -ForegroundColor DarkGray
    Write-Host "SẢN PHẨM :" $Product.Name -ForegroundColor Cyan
    Write-Host "NGÀY      :" $Date.ToString("dd/MM/yyyy HH:mm")
    Write-Host "THÁNG     :" "$Month/$Year"
    Write-Host "ĐẾN       :" $Target -ForegroundColor Yellow
    Write-Host "TRẠNG THÁI:" $Status
}

# ============================================================
# TẠO EXCEL
# ============================================================

try {
    $Excel = New-Object -ComObject Excel.Application
}
catch {
    Write-Host ""
    Write-Host "KHÔNG MỞ ĐƯỢC MICROSOFT EXCEL." -ForegroundColor Red
    Write-Host "Máy cần cài Microsoft Excel để tạo .xlsx." -ForegroundColor Yellow
    return
}

$Excel.Visible = $false
$Excel.DisplayAlerts = $false
$Workbook = $Excel.Workbooks.Add()

# SHEET 1: CHI_TIET
$Sheet1 = $Workbook.Worksheets.Item(1)
$Sheet1.Name = "CHI_TIET"

$Headers = @(
    "STT",
    "TÊN SẢN PHẨM",
    "NGÀY XÁC ĐỊNH",
    "NĂM",
    "THÁNG",
    "FOLDER THÁNG",
    "NGUỒN NGÀY",
    "ĐƯỜNG DẪN CŨ",
    "ĐƯỜNG DẪN MỚI",
    "TRẠNG THÁI"
)

for ($i = 0; $i -lt $Headers.Count; $i++) {
    $Sheet1.Cells.Item(1, $i + 1) = $Headers[$i]
}

$row = 2
$stt = 1

foreach ($Item in $Results) {
    $Sheet1.Cells.Item($row, 1) = $stt
    $Sheet1.Cells.Item($row, 2) = $Item.SanPham
    $Sheet1.Cells.Item($row, 3) = $Item.Ngay.ToString("dd/MM/yyyy HH:mm")
    $Sheet1.Cells.Item($row, 4) = $Item.Nam
    $Sheet1.Cells.Item($row, 5) = $Item.Thang
    $Sheet1.Cells.Item($row, 6) = $Item.FolderThang
    $Sheet1.Cells.Item($row, 7) = $Item.NguonNgay
    $Sheet1.Cells.Item($row, 8) = $Item.DuongDanCu
    $Sheet1.Cells.Item($row, 9) = $Item.DuongDanMoi
    $Sheet1.Cells.Item($row,10) = $Item.TrangThai
    $row++
    $stt++
}

$LastRow = [Math]::Max(2, $row - 1)
$HeaderRange = $Sheet1.Range("A1:J1")
$HeaderRange.Font.Bold = $true
$HeaderRange.Interior.ColorIndex = 15
$HeaderRange.HorizontalAlignment = -4108
$Sheet1.Range("A1:J$LastRow").AutoFilter() | Out-Null
$Sheet1.Activate()
$Excel.ActiveWindow.SplitRow = 1
$Excel.ActiveWindow.FreezePanes = $true
$Sheet1.Columns.AutoFit() | Out-Null
$Sheet1.Columns.Item(7).ColumnWidth = 45
$Sheet1.Columns.Item(8).ColumnWidth = 45
$Sheet1.Columns.Item(9).ColumnWidth = 55

# SHEET 2: TONG_HOP
$Sheet2 = $Workbook.Worksheets.Add()
$Sheet2.Name = "TONG_HOP"

$Sheet2.Cells.Item(1,1) = "NĂM"
$Sheet2.Cells.Item(1,2) = "THÁNG"
$Sheet2.Cells.Item(1,3) = "SỐ SẢN PHẨM"

$Summary = $Results |
    Group-Object Nam, Thang |
    ForEach-Object {
        $First = $_.Group[0]
        [PSCustomObject]@{
            Nam = $First.Nam
            Thang = $First.Thang
            SoLuong = $_.Count
        }
    } |
    Sort-Object Nam, Thang

$row = 2
foreach ($Item in $Summary) {
    $Sheet2.Cells.Item($row,1) = $Item.Nam
    $Sheet2.Cells.Item($row,2) = $Item.Thang
    $Sheet2.Cells.Item($row,3) = $Item.SoLuong
    $row++
}

$Sheet2.Range("A1:C1").Font.Bold = $true
$Sheet2.Range("A1:C1").Interior.ColorIndex = 15
$Sheet2.Columns.AutoFit() | Out-Null

# SHEET 3: CAU_TRUC
$Sheet3 = $Workbook.Worksheets.Add()
$Sheet3.Name = "CAU_TRUC"
$Sheet3.Cells.Item(1,1) = "CẤU TRÚC THƯ MỤC"
$Sheet3.Cells.Item(1,1).Font.Bold = $true

$script:TreeRow = 2
$RootName = Split-Path -Leaf $Root
$Sheet3.Cells.Item($script:TreeRow,1) = $RootName
$script:TreeRow++

function Write-FolderTree {
    param(
        [string]$Path,
        [int]$Level = 1
    )

    $Folders = Get-ChildItem `
        -LiteralPath $Path `
        -Directory `
        -ErrorAction SilentlyContinue |
        Sort-Object Name

    foreach ($Folder in $Folders) {
        $Indent = "    " * $Level
        $Sheet3.Cells.Item($script:TreeRow,1) = "$Indent├── $($Folder.Name)"
        $script:TreeRow++
        Write-FolderTree -Path $Folder.FullName -Level ($Level + 1)
    }
}

Write-FolderTree -Path $Root
$Sheet3.Columns.Item(1).ColumnWidth = 90

# LƯU XLSX
$Workbook.SaveAs($ExcelReport, 51)
$Workbook.Close($true)
$Excel.Quit()

[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Sheet1) | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Sheet2) | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Sheet3) | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Workbook) | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Excel) | Out-Null

[GC]::Collect()
[GC]::WaitForPendingFinalizers()

Write-Host ""
Write-Host "=============================================" -ForegroundColor Green

if ($Preview) {
    Write-Host "ĐÃ XEM THỬ - CHƯA DI CHUYỂN FOLDER" -ForegroundColor Green
}
else {
    Write-Host "ĐÃ HOÀN TẤT DI CHUYỂN" -ForegroundColor Green
}

Write-Host ""
Write-Host "FILE EXCEL BÁO CÁO:" -ForegroundColor Cyan
Write-Host $ExcelReport -ForegroundColor Yellow
Write-Host "=============================================" -ForegroundColor Green
</script>

<script>
(function(){
  const rootEl = document.getElementById('root');
  const codeEl = document.getElementById('code');
  const statusEl = document.getElementById('status');

  function modeValue(){
    return document.querySelector('input[name="mode"]:checked').value;
  }

  function escapePowerShellSingleQuoted(s){
    return s.replace(/'/g, "''");
  }

  function generate(){
    const root = rootEl.value.trim();
    if(!root){
      statusEl.textContent = 'Hãy nhập đường dẫn folder.';
      codeEl.value = '';
      return;
    }

    let tpl = document.getElementById('ps-template').textContent;
    tpl = tpl.replace(/__ROOT__/g, escapePowerShellSingleQuoted(root));
    tpl = tpl.replace(/__PREVIEW__/g, modeValue() === 'preview' ? '$true' : '$false');

    codeEl.value = tpl.trim();
    statusEl.textContent = modeValue() === 'preview'
      ? 'Đã tạo code ở chế độ XEM THỬ.'
      : 'Đã tạo code ở chế độ CHẠY THẬT. Kiểm tra kỹ trước khi chạy.';
  }

  async function copyCode(){
    generate();
    if(!codeEl.value) return;

    try{
      await navigator.clipboard.writeText(codeEl.value);
      statusEl.textContent = 'Đã copy code PowerShell.';
    }catch(err){
      codeEl.focus();
      codeEl.select();
      document.execCommand('copy');
      statusEl.textContent = 'Đã copy code PowerShell.';
    }
  }

  function downloadPS1(){
    generate();
    if(!codeEl.value) return;

    const root = rootEl.value.trim();
    let folderName = root.split('\\').filter(Boolean).pop() || 'chia_folder';
    folderName = folderName.replace(/[<>:"/\\|?*]/g, '_');

    const blob = new Blob(["\uFEFF" + codeEl.value], {type:'text/plain;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'CHIA_THANG_' + folderName + '.ps1';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 1000);
    statusEl.textContent = 'Đã tạo file .ps1.';
  }

  document.getElementById('generateBtn').addEventListener('click', generate);
  document.getElementById('copyBtn').addEventListener('click', copyCode);
  document.getElementById('downloadBtn').addEventListener('click', downloadPS1);
  rootEl.addEventListener('input', generate);
  document.querySelectorAll('input[name="mode"]').forEach(el => el.addEventListener('change', generate));

  generate();
})();
</script>
</body>
</html>
